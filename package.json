{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.2"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "nest build",
    "test": "bun test test",
    "test:watch": "bun test test --watch",
    "migration:up": "mikro-orm migration:up --config mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.806.0",
    "@mikro-orm/core": "6.5.9",
    "@mikro-orm/migrations": "6.5.9",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.5.9",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.5.9",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/bun": "1.3.2",
    "typescript": "5.9.2"
  }
}
