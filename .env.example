# HTTP
PORT=3000

# PostgreSQL
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
DATABASE_URL=postgresql://wagering:wagering@postgres:5432/wagering

# SQS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
WAGER_EVENTS_QUEUE_NAME=wager-events.fifo
# WAGER_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo

# Transactional outbox publisher
OUTBOX_PUBLISHER_BATCH_SIZE=20
OUTBOX_PUBLISHER_LEASE_MS=30000
OUTBOX_PUBLISHER_RETRY_BASE_MS=1000
OUTBOX_PUBLISHER_RETRY_MAX_MS=60000
# OUTBOX_PUBLISHER_STOP_WHEN_IDLE=true
